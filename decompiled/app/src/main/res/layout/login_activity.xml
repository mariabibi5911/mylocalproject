<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContainer"
    android:background="@drawable/bg_login_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loginContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="24dp">
            <View
                android:background="@drawable/gradient_glow"
                android:layout_width="88dp"
                android:layout_height="88dp"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_shield_logo"
                android:contentDescription="@string/app_name"/>
        </FrameLayout>
        <TextView
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NGI PRO"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#00d4ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_subtitle"
            android:alpha="0.75"
            android:letterSpacing="0.3"/>
        <View
            android:background="#2a2a35"
            android:layout_width="52dp"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="36dp"/>
        <FrameLayout
            android:id="@+id/cardGithub"
            android:background="@drawable/bg_login_button_ripple"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_github"
                    android:contentDescription="GitHub"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_with_github"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.04"/>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/login_disclaimer"
            android:lineSpacingExtra="3dp"
            android:alpha="0.45"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/loadingContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="#00d4ff"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#00d4ff"
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="INITIALIZING..."
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.15"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="NGI PRO v1.0"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:alpha="0.35"
        android:letterSpacing="0.1"/>
</RelativeLayout>
