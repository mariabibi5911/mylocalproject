<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarProfile"
        android:background="@color/bg_surface"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:title="@string/profile_title"
        app:titleTextColor="@color/text_primary"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:cardBackgroundColor="@color/accent_cyan"
            app:cardCornerRadius="52dp">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:layout_width="98dp"
                android:layout_height="98dp"
                app:cardBackgroundColor="@color/bg_root"
                app:cardCornerRadius="49dp">
                <ImageView
                    android:id="@+id/profileAvatar"
                    android:padding="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_shield_logo"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:id="@+id/profileUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="NGI User"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/accent_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/profile_connected_via"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/bg_surface_alt"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/profile_files_analyzed"
                android:layout_weight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:id="@+id/profileFilesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/btnProfileLogout"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/accent_danger"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_logout"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
