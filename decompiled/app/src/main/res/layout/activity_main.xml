<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:background="@color/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="90dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.appbar.AppBarLayout
                    android:background="@color/bg_surface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="0dp">
                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
                        app:subtitle="@string/toolbar_subtitle"
                        app:subtitleTextColor="#8800d4ff"
                        app:title="@string/toolbar_title"
                        app:titleTextColor="@color/accent_cyan"/>
                </com.google.android.material.appbar.AppBarLayout>
                <androidx.cardview.widget.CardView
                    android:id="@+id/profileStrip"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/bg_surface_alt"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            app:cardBackgroundColor="@color/bg_root"
                            app:cardCornerRadius="23dp">
                            <ImageView
                                android:id="@+id/homeAvatar"
                                android:padding="8dp"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_shield_logo"
                                android:scaleType="centerCrop"/>
                        </androidx.cardview.widget.CardView>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:id="@+id/homeUserName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NGI User"/>
                            <TextView
                                android:textSize="11sp"
                                android:textColor="@color/accent_success"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="● Connected via GitHub"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_media_play"
                            android:rotation="0"
                            app:tint="@color/text_muted"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <View
                        android:id="@+id/statusDot"
                        android:background="@android:drawable/presence_online"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/accent_success"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:ellipsize="middle"
                        android:id="@+id/statusFileText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="no file loaded"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOOLS"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:letterSpacing="0.12"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/toolsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:nestedScrollingEnabled="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RESULTS"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:letterSpacing="0.12"/>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:layout_marginTop="0dp"
                    app:cardBackgroundColor="@color/bg_surface_alt"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="140dp">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/resultsList"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                        <LinearLayout
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/emptyState"
                            android:padding="28dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/emptyStateIcon"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@android:drawable/ic_menu_search"
                                android:alpha="0.6"
                                app:tint="@color/text_muted"/>
                            <ProgressBar
                                android:id="@+id/emptyStateProgress"
                                android:visibility="gone"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:indeterminateTint="@color/accent_cyan"/>
                            <TextView
                                android:textSize="12.5sp"
                                android:textColor="@color/text_muted"
                                android:gravity="center"
                                android:id="@+id/emptyStateText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/results_empty_state"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/btnSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="22dp"
            android:elevation="10dp"
            app:backgroundTint="@color/accent_cyan"
            app:elevation="10dp"
            app:maxImageSize="26dp"
            app:srcCompat="@android:drawable/ic_input_add"
            app:tint="@color/text_on_accent"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/nav_view"
        android:background="@color/bg_surface"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        app:headerLayout="@layout/nav_header"
        app:itemIconPadding="20dp"
        app:itemIconTint="@color/accent_cyan"
        app:itemShapeAppearanceOverlay="@style/ShapeAppearance.NGI.NavItem"
        app:itemShapeFillColor="@color/accent_cyan_dim"
        app:itemShapeInsetEnd="8dp"
        app:itemShapeInsetStart="8dp"
        app:itemTextColor="@color/text_secondary"
        app:menu="@menu/drawer_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
