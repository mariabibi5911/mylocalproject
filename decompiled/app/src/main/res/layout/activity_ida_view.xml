<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/functionListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarList"
            android:background="@color/bg_surface"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:title="IDA View — Functions"
            app:titleTextColor="@color/text_primary"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:id="@+id/functionCountText"
            android:background="@color/bg_surface_alt"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading functions…"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/functionRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/detailContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarDetail"
            android:background="@color/bg_surface"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:titleTextColor="@color/text_primary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/bg_surface_alt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:gravity="center"
                android:id="@+id/tabDisasm"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Disassembly"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:id="@+id/tabPseudo"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Pseudocode"
                android:layout_weight="1"/>
        </LinearLayout>
        <ScrollView
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="12.5sp"
                android:textColor="@color/console_text"
                android:id="@+id/detailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading…"
                android:lineSpacingExtra="3dp"
                android:textIsSelectable="true"
                android:fontFamily="monospace"/>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
