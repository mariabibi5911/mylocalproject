<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolCard"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_surface_alt"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="@color/accent_cyan_dim"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/toolIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/accent_cyan"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:id="@+id/toolLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tool"
            android:maxLines="2"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
